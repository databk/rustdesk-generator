---
import Layout from '@/layouts/Layout.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/starwind/card';
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';
import { Spinner } from '@/components/starwind/spinner';
import { translations as uiTranslations, LOCALES } from '@/lib/i18n/translations';

const uiTranslationsJson = JSON.stringify(uiTranslations);
const localesJson = JSON.stringify(LOCALES);
---

<Layout title="Build Status - RustDesk Generator">
  <div class="min-h-screen">
    <header class="border-b border-border bg-card/50 backdrop-blur-sm sticky top-0 z-10">
      <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-3">
            <div class="size-9 rounded-lg bg-primary flex items-center justify-center">
              <svg class="size-5 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <path d="M8 21h8M12 17v4" />
              </svg>
            </div>
            <div>
              <h1 class="text-lg font-semibold leading-tight" data-i18n="app.title">RustDesk Generator</h1>
              <p class="text-xs text-muted-foreground" data-i18n="status.buildStatus">Build Status</p>
            </div>
          </a>
        </div>
        <div class="flex items-center gap-2">
          <select id="lang-select" class="rounded-md border border-input bg-background px-2 py-1 text-xs">
            {LOCALES.map((l) => (
              <option value={l.value}>{l.label}</option>
            ))}
          </select>
          <Button variant="ghost" size="sm" id="theme-toggle">
            <svg class="size-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <svg class="size-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </Button>
        </div>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 py-8">
      <div id="loading-state" class="flex flex-col items-center justify-center py-20">
        <Spinner class="size-8" />
        <p class="mt-4 text-muted-foreground" data-i18n="status.loading">Loading build status...</p>
      </div>

      <div id="error-state" class="hidden flex flex-col items-center justify-center py-20">
        <div class="text-center">
          <p id="error-message" class="text-error-foreground mb-4"></p>
          <Button as="a" href="/" data-i18n="status.backToHome">Back to Home</Button>
        </div>
      </div>

      <div id="build-content" class="hidden space-y-6">
        <div class="flex items-center gap-2 text-sm">
          <a href="/" class="text-primary hover:underline" data-i18n="status.backToHome">← Back to Home</a>
        </div>

        <Card>
          <CardHeader>
            <div class="flex items-center justify-between">
              <div>
                <CardTitle id="build-title" data-i18n="status.buildStatus">Build Status</CardTitle>
                <CardDescription id="build-meta"></CardDescription>
              </div>
              <Badge id="build-status-badge" variant="secondary"></Badge>
            </div>
          </CardHeader>
          <CardContent>
            <div id="build-message" class="hidden rounded-md bg-muted p-3 mt-4">
              <p class="text-sm text-muted-foreground" id="build-message-text"></p>
            </div>
          </CardContent>
        </Card>

        <div id="download-section" class="hidden">
          <Card>
            <CardHeader>
              <CardTitle data-i18n="status.download">Download</CardTitle>
              <CardDescription data-i18n="status.downloadDesc">Your build is ready. Download the files below.</CardDescription>
            </CardHeader>
            <CardContent>
              <div id="download-list" class="space-y-3"></div>
            </CardContent>
          </Card>
        </div>

        <div id="failed-section" class="hidden">
          <Card>
            <CardHeader>
              <CardTitle data-i18n="status.buildFailed">Build Failed</CardTitle>
              <CardDescription data-i18n="status.buildFailedDesc">The build process encountered an error.</CardDescription>
            </CardHeader>
            <CardContent>
              <p class="text-sm text-muted-foreground mb-4">
                Please try again or check the build configuration.
              </p>
              <Button as="a" href="/" data-i18n="status.startNewBuild">Start New Build</Button>
            </CardContent>
          </Card>
        </div>

        <div id="active-section" class="hidden">
          <Card>
            <CardContent class="pt-6">
              <div class="flex items-center gap-3">
                <Spinner class="size-5" />
                <p class="text-sm text-muted-foreground" id="active-message"></p>
              </div>
              <p class="mt-2 text-xs text-muted-foreground" data-i18n="status.autoRefresh">
                This page will auto-refresh every 5 seconds.
              </p>
            </CardContent>
          </Card>
        </div>
      </div>
    </main>
  </div>

  <script is:inline define:vars={{ uiTranslationsJson, localesJson }}>
    window.__uiTranslations = JSON.parse(uiTranslationsJson);
    window.__locales = JSON.parse(localesJson);
  </script>

  <script>
    // @ts-nocheck
    const API_URL = import.meta.env.PUBLIC_API_URL || '';
    const params = new URLSearchParams(window.location.search);
    const buildId = params.get('id') || '';

    const uiT = window.__uiTranslations;

    function getStoredLocale() {
      const stored = localStorage.getItem('locale');
      if (stored && ['en-US','zh-CN','es-ES','fr-FR','pt-BR','ru-RU'].includes(stored)) return stored;
      return 'en-US';
    }

    function applyTranslations(locale) {
      const ui = uiT[locale] || uiT['en-US'];
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        const key = el.getAttribute('data-i18n');
        if (key && ui[key]) el.textContent = ui[key];
      });
      document.documentElement.setAttribute('lang', locale);
    }

    const currentLocale = getStoredLocale();
    const langSelect = document.getElementById('lang-select');
    if (langSelect) langSelect.value = currentLocale;
    applyTranslations(currentLocale);

    if (langSelect) {
      langSelect.addEventListener('change', function() {
        const locale = langSelect.value;
        localStorage.setItem('locale', locale);
        applyTranslations(locale);
      });
    }

    const loadingState = document.getElementById('loading-state');
    const errorState = document.getElementById('error-state');
    const errorMessage = document.getElementById('error-message');
    const buildContent = document.getElementById('build-content');
    const buildTitle = document.getElementById('build-title');
    const buildMeta = document.getElementById('build-meta');
    const buildStatusBadge = document.getElementById('build-status-badge');
    const buildMessage = document.getElementById('build-message');
    const buildMessageText = document.getElementById('build-message-text');
    const downloadSection = document.getElementById('download-section');
    const downloadList = document.getElementById('download-list');
    const failedSection = document.getElementById('failed-section');
    const activeSection = document.getElementById('active-section');
    const activeMessage = document.getElementById('active-message');
    const themeToggle = document.getElementById('theme-toggle');

    const STATUS_VARIANTS = {
      pending: 'secondary',
      building: 'default',
      completed: 'default',
      failed: 'destructive',
    };

    themeToggle.addEventListener('click', function() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });

    if (!buildId) {
      loadingState.classList.add('hidden');
      errorState.classList.remove('hidden');
      errorMessage.textContent = uiT[currentLocale]?.['status.missingId'] || 'Missing build ID';
    } else {
      pollBuildStatus();
    }

    function pollBuildStatus() {
      fetch(API_URL + '/api/build/' + buildId)
        .then(function(res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function(build) {
          loadingState.classList.add('hidden');
          buildContent.classList.remove('hidden');
          renderBuild(build);

          if (build.status === 'pending' || build.status === 'building') {
            setTimeout(pollBuildStatus, 5000);
          }
        })
        .catch(function(e) {
          loadingState.classList.add('hidden');
          errorState.classList.remove('hidden');
          errorMessage.textContent = e instanceof Error ? e.message : 'Failed to fetch build status';
        });
    }

    function renderBuild(build) {
      buildTitle.textContent = 'Build #' + build.uuid.slice(0, 8);
      buildMeta.textContent = build.os + (build.arch ? ' / ' + build.arch : '') + ' · ' + new Date(build.created_at).toLocaleString();
      buildStatusBadge.textContent = build.status;

      if (build.message) {
        buildMessageText.textContent = build.message;
        buildMessage.classList.remove('hidden');
      }

      downloadSection.classList.add('hidden');
      failedSection.classList.add('hidden');
      activeSection.classList.add('hidden');

      if (build.status === 'completed' && build.files && build.files.length > 0) {
        downloadSection.classList.remove('hidden');
        const ui = uiT[getStoredLocale()] || uiT['en-US'];
        const downloadLabel = ui['status.download'] || 'Download';
        downloadList.innerHTML = build.files.map(function(filename) {
          return '<a href="' + API_URL + '/api/download/' + build.uuid + '/' + filename + '" class="flex items-center justify-between rounded-md border border-border px-4 py-3 hover:bg-accent transition-colors">' +
            '<span class="text-sm font-medium">' + filename + '</span>' +
            '<span class="text-sm text-primary">' + downloadLabel + ' ↓</span>' +
            '</a>';
        }).join('');
      } else if (build.status === 'failed') {
        failedSection.classList.remove('hidden');
      } else if (build.status === 'pending' || build.status === 'building') {
        activeSection.classList.remove('hidden');
        const ui = uiT[getStoredLocale()] || uiT['en-US'];
        activeMessage.textContent = build.status === 'pending' ? (ui['status.waiting'] || 'Waiting for build to start...') : (ui['status.inProgress'] || 'Build in progress...');
      }
    }
  </script>
</Layout>
